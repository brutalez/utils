{
  "name": "@brutalez/toolkit",
  "version": "1.0.0",
  "description": "A small, typed, zero-dependency collection of everyday TypeScript utilities, grouped into short namespaces that are easy to discover and easy to import.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Alim Naufal",
    "email": "alimnfll@gmail.com",
    "url": "https://alimnfl.com"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.65.0",
    "prettier": "^3.0.0",
    "tsd": "^0.33.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react-dom": "^19.3.0"
  }
}
