{
  "name": "@brutalez/utils",
  "version": "1.0.0",
  "description": "Small, typed, zero-dependency TypeScript utilities for strings, numbers, arrays, dates, objects, JSON, and durations",
  "keywords": [
    "typescript",
    "utils",
    "utilities",
    "utils",
    "string",
    "array",
    "date",
    "object",
    "json",
    "duration"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Alim Naufal",
    "email": "alimnfll@gmail.com",
    "url": "https://alimnfl.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brutalez/utils"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.js"
    },
    "./number": {
      "types": "./dist/number.d.ts",
      "import": "./dist/number.js"
    },
    "./array": {
      "types": "./dist/array.d.ts",
      "import": "./dist/array.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.js"
    },
    "./object": {
      "types": "./dist/object.d.ts",
      "import": "./dist/object.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./duration": {
      "types": "./dist/duration.d.ts",
      "import": "./dist/duration.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test && npm run typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
